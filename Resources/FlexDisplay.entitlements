<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox intentionally OFF for local Debug builds.
	     CGConfigureDisplayWithDisplayMode / gamma transfer need a non-sandboxed process.
	     App Store distribution would require special entitlements and review. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
